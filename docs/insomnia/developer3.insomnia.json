    {
      "_id": "req_dev3_1",
      "_type": "request",
      "parentId": "fld_approval",
      "name": "Calculate approval route",
      "description": "Stores amount/risk levels and MAX routing explanation.",
      "method": "POST",
      "url": "{{ _.approvalBaseUrl }}/api/v1/approval-routes",
      "headers": [
        {
          "name": "Content-Type",
          "value": "application/json"
        }
      ],
      "body": {
        "mimeType": "application/json",
        "text": "{\n  \"paymentId\": 1,\n  \"requesterId\": 1,\n  \"paymentAmount\": 75000,\n  \"riskBand\": \"HIGH\",\n  \"amountApprovalLevel\": \"L2\",\n  \"configurationVersion\": \"demo-v1\"\n}"
      }
    },
    {
      "_id": "req_dev3_2",
      "_type": "request",
      "parentId": "fld_approval",
