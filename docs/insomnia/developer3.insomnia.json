        },
        {
          "name": "Authorization",
          "value": "Bearer {{ _.token }}"
        }
      ],
      "body": {
        "mimeType": "application/json",
        "text": "{\n  \"paymentId\": 1,\n  \"assignedApproverId\": 2,\n  \"slaMinutes\": 60\n}"
