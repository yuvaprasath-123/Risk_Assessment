        "approvalBaseUrl": "http://localhost:8089",
        "processingBaseUrl": "http://localhost:8090",
        "securityBaseUrl": "http://localhost:8081",
        "paymentId": 1,
        "approvalTaskId": 1,
        "token": ""
      }
