                        "supplierId": "301",
                        "invoiceNumber": "DEMO-INV-001",
                        "invoiceAmount": "1234.50",
                        "currencyCode": "INR"
                      },
                      "supplier": {
                        "supplierId": "301",
                        "statusAsOfCutoff": "ACTIVE",
                        "createdAt": "2025-01-01T00:00:00Z"
                      },
                      "currentAndRetryIdentities": [
                        {
                          "source": "payment-request",
                          "key": "handoff-demo-001"
                        }
                      ],
                      "certification": {
                        "code": "AUTHORITATIVE_VALIDATION_PASS_V1",
                        "complete": true,
                        "asOfCutoff": true,
                        "immutable": true,
                        "validationPaymentBindingVerified": true,
                        "requesterOwnershipVerified": true,
                        "eligibleForRiskAssessment": true,
                        "retryIdentityScope": "SAME_LOGICAL_SUBMISSION"
                      },
                      "provenance": {
                        "serviceId": "payment-facts-provider",
                        "recordReference": "facts-501",
                        "recordRevision": "1"
