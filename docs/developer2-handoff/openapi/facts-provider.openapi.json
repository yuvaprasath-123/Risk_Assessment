{
  "openapi": "3.1.0",
  "info": {
    "title": "Authoritative Facts provider protocol (proposal)",
    "version": "2026-10-16",
    "description": "Developer 2 provider protocol proposal consumed by implemented opt-in clients. This is NOT an existing Developer 1 endpoint. No credentials are included. See ../README.md and the handoff guide for relational, trust and recovery invariants."
  },
  "servers": [
    {
      "url": "https://facts-provider.invalid"
    }
  ],
  "paths": {
    "/internal/v1/risk-facts/resolve": {
      "post": {
        "operationId": "resolveFacts",
        "summary": "resolveFacts",
        "description": "Proposed provider obligation: certify authority via configured provider trust plus PASS/reference/payment binding, not a digest or self-asserted serviceId. Exact request echo, original-cutoff immutable receipt; 410 if irreproducible.",
        "security": [
          {
            "ServiceBearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
