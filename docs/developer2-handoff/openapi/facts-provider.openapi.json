                    "summary": "Synthetic validated handoff example: facts-response",
                    "value": {
                      "contractVersion": "risk-authoritative-facts-v1",
                      "submission": {
                        "source": "payment-request",
                        "key": "handoff-demo-001"
                      },
                      "paymentId": "501",
                      "requesterId": "601",
                      "validation": {
                        "reference": "validation-501",
                        "revision": "1",
                        "outcome": "PASS",
                        "validatedAt": "2026-10-16T11:30:01Z",
                        "immutableReference": true
                      },
                      "cutoff": "2026-10-16T12:00:00.123456789Z",
                      "payment": {
                        "invoiceId": "401",
                        "supplierId": "301",
                        "amount": "1234.50",
                        "currencyCode": "INR",
                        "submittedAt": "2026-10-16T11:30:00Z",
                        "completedAt": null,
                        "statusAsOfCutoff": "PENDING_APPROVAL"
